# Copy this file to .env locally and fill values.
# Never commit real secrets.

# LLM / Embedding provider
DASHSCOPE_API_KEY=

# Admin login for local Streamlit demo
ADMIN_USER=admin
ADMIN_PWD=change-me

# AMap / Gaode web service
GAODE_API_KEY=
GAODE_BASE_URL=https://restapi.amap.com
GAODE_TIMEOUT=5

# Ark / Seed evaluation, optional
ARK_API_KEY=
ARK_BASE_URL=https://ark-cn-beijing.bytedance.net/api/v3
ARK_SEED2_PRO_MODEL=ep-20260609191630-7gkjm
ARK_SEEDANCE_MODEL=ep-20260609151048-sbfnk
ARK_SEEDANCE_TASK_URL=https://ark-cn-beijing.bytedance.net/api/v3/contents/generations/tasks

# Agent tool governance
AGENT_REQUIRE_CONFIRMATION=false
AGENT_ENFORCE_TOOL_POLICY=true
AGENT_ALLOWED_PERMISSION_SCOPES=*
AGENT_AUDIT_LOG_DIR=logs/audit
AGENT_TASK_RUN_DIR=logs/tasks
AGENT_REVIEW_QUEUE_DIR=logs/review
AGENT_EVAL_SAMPLE_DIR=logs/eval_samples
AGENT_AUTO_CAPTURE_EVAL_SAMPLES=true
